# Google AI Studio API Key (Free Tier)
# Get your free key at: https://aistudio.google.com/app/apikey
# Powers the Gemma open-weights Code Necromancer & Calaverita Literaria poet
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Open-Weight Gemma Model Name (Free Tier on Google AI Studio)
# Default: "gemma-4-26b-a4b-it" (Google's latest Gemma 4 open-weights)
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# SerpAPI Key (Free Tier: 100 free searches/month)
# Get your free key at: https://serpapi.com
# Used by searchGameLoreTool to retrieve game release year, creator credits, and Newgrounds lore
# If omitted or quota depleted, the app automatically falls back to DuckDuckGo & curated archive
SERPAPI_API_KEY=your_serpapi_key_here
